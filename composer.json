{
    "name": "ttpryg/content-engine",
    "description": "A framework-agnostic standalone CMS content engine library for PHP.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.53",
        "laravel/pint": "^1.20",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.6"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ttpryg\\ContentEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ttpryg\\ContentEngine\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    },
    "scripts": {
        "fix": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ],
        "fix:check": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test"],
        "test": "vendor/bin/phpunit"
    }
}
